{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Birthday recipe library canonical recipe record",
  "description": "Authoring schema. Passing it is not evidence of cook testing or safety certification.",
  "type": "object",
  "required": ["id", "categoryId", "titleZh", "titleEn", "summary", "servings", "yieldText", "difficulty", "activeMinutes", "prepMinutes", "cookMinutes", "restMinutes", "totalMinutes", "equipment", "ingredients", "prepSteps", "steps", "substitutions", "failurePrevention", "storage", "allergens", "safetySourceIds", "recipeSources", "adaptationNote", "testStatus"],
  "properties": {
    "id": {"type":"string", "pattern":"^(jin|chuan|xiang|lu|yue|jiangzhe|western-dessert)-[0-9]{3}$"},
    "categoryId":{"enum":["jin","chuan","xiang","lu","yue","jiangzhe","western-dessert"]},
    "titleZh":{"type":"string","minLength":2},
    "titleEn":{"type":"string","minLength":3},
    "summary":{"type":"string","minLength":12},
    "servings":{"type":"number","exclusiveMinimum":0},
    "yieldText":{"type":"string","minLength":3},
    "difficulty":{"enum":["beginner","intermediate","project"]},
    "activeMinutes":{"type":"integer","minimum":1},
    "prepMinutes":{"type":"integer","minimum":0},
    "cookMinutes":{"type":"integer","minimum":0},
    "restMinutes":{"type":"integer","minimum":0},
    "totalMinutes":{"type":"integer","minimum":1},
    "chillMinutes":{"type":"integer","minimum":0},
    "timingNote":{"type":"string"},
    "tags":{"type":"array","items":{"type":"string"},"uniqueItems":true},
    "equipment":{"type":"array","minItems":1,"items":{"type":"object","required":["name","size","alternative"],"properties":{"name":{"type":"string"},"size":{"type":"string"},"alternative":{"type":"string"}},"additionalProperties":true}},
    "ingredients":{"type":"array","minItems":2,"items":{"type":"object","required":["id","group","nameZh","nameUk","quantity","unit","prep","allergens","packLabelCheck"],"properties":{"id":{"type":"string"},"group":{"type":"string"},"nameZh":{"type":"string"},"nameUk":{"type":"string"},"quantity":{"type":"number","exclusiveMinimum":0},"unit":{"type":"string"},"quantityBasis":{"type":"string"},"prep":{"type":"string"},"allergens":{"type":"array","items":{"type":"string"},"uniqueItems":true},"packLabelCheck":{"type":"string"},"optional":{"type":"boolean"}},"additionalProperties":true}},
    "prepSteps":{"type":"array","minItems":1,"items":{"type":"string","minLength":5}},
    "steps":{"type":"array","minItems":3,"items":{"type":"object","required":["id","title","action","ingredientIds","equipment","heat","durationMin","durationMax","visualCue","doneness","safety"],"properties":{"id":{"type":"string"},"title":{"type":"string"},"action":{"type":"string","minLength":10},"ingredientIds":{"type":"array","items":{"type":"string"}},"equipment":{"type":"array","items":{"type":"string"}},"heat":{"type":"string"},"durationMin":{"type":"number","minimum":0},"durationMax":{"type":"number","minimum":0},"visualCue":{"type":"string"},"doneness":{"type":"string"},"safety":{"type":"string"}},"additionalProperties":true}},
    "substitutions":{"type":"array","items":{"type":"object","required":["ingredientId","alternative","quantity","unit","methodChange","flavourChange","allergenChange"],"properties":{"ingredientId":{"type":"string"},"alternative":{"type":"string"},"quantity":{"type":"number","exclusiveMinimum":0},"unit":{"type":"string"},"methodChange":{"type":"string"},"flavourChange":{"type":"string"},"allergenChange":{"type":"string"}},"additionalProperties":true}},
    "failurePrevention":{"type":"array","minItems":2,"items":{"type":"object","required":["symptom","cause","fix"],"properties":{"symptom":{"type":"string"},"cause":{"type":"string"},"fix":{"type":"string"}},"additionalProperties":true}},
    "storage":{"type":"object","required":["cooling","fridgeMaxHours","freezerQualityDays","reheatMethod","reheatLimit"],"properties":{"cooling":{"type":"string"},"fridgeMaxHours":{"type":["integer","null"],"minimum":0},"freezerQualityDays":{"type":["integer","null"],"minimum":0},"reheatMethod":{"type":"string"},"reheatLimit":{"type":"integer","minimum":0,"maximum":1},"thawMethod":{"type":"string"},"storageNote":{"type":"string"}},"additionalProperties":true},
    "allergens":{"type":"array","items":{"type":"string"},"uniqueItems":true},
    "safetySourceIds":{"type":"array","items":{"type":"string"},"uniqueItems":true},
    "recipeSources":{"type":"array","items":{"type":"object","required":["title","url","supports"],"properties":{"title":{"type":"string"},"publisher":{"type":"string"},"url":{"type":"string","format":"uri"},"supports":{"type":"string"},"accessedDate":{"type":"string"}},"additionalProperties":true}},
    "adaptationNote":{"type":"string"},
    "testStatus":{"const":"editorially-reviewed-not-cook-tested"},
    "milkIngredientPolicy":{"type":"object","properties":{"noIntentionallyAddedMilk":{"const":true},"packagedProductsNeedLabelCheck":{"const":true},"notACrossContactGuarantee":{"const":true}},"additionalProperties":true}
  },
  "additionalProperties":true
}
