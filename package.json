{
  "name": "birthday-kitchen-v3",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5186 --strictPort",
    "build": "node scripts/validate-recipes.mjs && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4186 --strictPort",
