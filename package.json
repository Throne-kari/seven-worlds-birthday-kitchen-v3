    "validate:data": "node scripts/validate-recipes.mjs",
    "test:browser": "node scripts/verify-v3.mjs",
    "serve": "node scripts/serve-dist.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.1",
    "vite": "^8.3.4"
  }
}
